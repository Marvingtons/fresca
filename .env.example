# Contact form email, sent through Resend (see app/api/contact/route.ts).
# Production: set as Worker secrets with `npx wrangler secret put <NAME>`.
# Without them the form shows its error message instead of "Thank you".
RESEND_API_KEY=
CONTACT_TO_EMAIL=frescainteriordesign@gmail.com
# Optional sender on the site's domain once it is verified in Resend, e.g.
# "Fresca website <website@frescainteriordesign.com>". Left empty, the route uses
# Resend's onboarding sender (onboarding@resend.dev), which only delivers to the
# email address that owns the Resend account.
CONTACT_FROM_EMAIL=

# Canonical site URL. Single source for canonical, og:url, og:image, sitemap,
# robots and JSON-LD; inlined at build time, and production builds fail without it.
# UNCONFIRMED: assumed domain until Karen confirms it.
NEXT_PUBLIC_SITE_URL=https://frescainteriordesign.com

# Media bucket for the hero film and poster (Cloudflare R2). Swap for the custom
# domain once it's attached; r2.dev URLs are rate limited and not for production.
NEXT_PUBLIC_MEDIA_BASE=https://pub-364f647b29874b09922e1889f267c323.r2.dev

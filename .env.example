# Contact form email, sent through Resend (see app/api/contact/route.ts).
# Production: set as Worker secrets with `npx wrangler secret put <NAME>`.
# Without them the form shows its error message instead of "Thank you".
RESEND_API_KEY=
# Inbox for inquiries (decided).
CONTACT_TO_EMAIL=frescainteriordesign@gmail.com
# Sender, on the sending domain frescainteriordesign.com (Resend). Set this secret
# only once Resend shows the domain as Verified: Resend rejects a sender on an
# unverified domain. While it is unset the route uses Resend's onboarding sender
# (onboarding@resend.dev), which only delivers to the Resend account owner.
CONTACT_FROM_EMAIL=hello@frescainteriordesign.com

# Canonical site URL (decided: the apex, no www). Single source for canonical,
# og:url, og:image, sitemap, robots, the JSON-LD url fields and the www to apex
# redirect; inlined at build time, and production builds fail without it.
NEXT_PUBLIC_SITE_URL=https://frescainteriordesign.com

# Media bucket for the hero film (Cloudflare R2), on its custom domain
# (docs/DEPLOY.md, step 6). Dev fallback until that domain is attached:
#   https://pub-364f647b29874b09922e1889f267c323.r2.dev
# r2.dev is rate limited and not for production; it is disabled in step 6.
NEXT_PUBLIC_MEDIA_BASE=https://media.frescainteriordesign.com

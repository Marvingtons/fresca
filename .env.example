# Contact form email, sent through Resend (see app/api/contact/route.ts).
# Production: set all three as Worker secrets with `npx wrangler secret put <NAME>`.
# Until they are set the form shows its error message instead of "Thank you".
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Fresca website <website@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Canonical site URL (set once the real domain is attached)
NEXT_PUBLIC_SITE_URL=

# Media bucket for the hero film and poster (Cloudflare R2). Swap for the custom
# domain once it's attached; r2.dev URLs are rate limited and not for production.
NEXT_PUBLIC_MEDIA_BASE=https://pub-364f647b29874b09922e1889f267c323.r2.dev

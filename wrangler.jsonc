{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fresca-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom domains: `wrangler deploy` creates the DNS records and certificates.
  // Delete any existing A, AAAA or CNAME on these names first (docs/DEPLOY.md).
  // www is redirected to the apex by a Cloudflare Redirect Rule before it
  // reaches the Worker.
  "routes": [
    { "pattern": "frescainteriordesign.com", "custom_domain": true },
    { "pattern": "www.frescainteriordesign.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // next/image is served by Cloudflare Images (OpenNext wires /_next/image to it),
  // so photos keep their WebP/AVIF srcsets.
  "images": {
    "binding": "IMAGES"
  },
  // NEXT_PUBLIC_SITE_URL and NEXT_PUBLIC_MEDIA_BASE are inlined at build time
  // from .env.local or the shell (see .env.example and docs/DEPLOY.md), so they
  // are not Worker vars. Form secrets: RESEND_API_KEY, CONTACT_TO_EMAIL.
  "observability": {
    "enabled": true
  }
}
